<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--===============================//
    //   Helpdesk Ticket Form View    //
    //===============================-->
    <record id="view_helpdesk_ticket_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <!-- Add employee_ids field before user_id -->
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="employee_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="Assign employees..."/>
            </xpath>

            <!--  assign and deadline -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="assign_date"/>
                <field name="deadline"/>
            </xpath>
        </field>
    </record>


    <!--===============================//
    //   Helpdesk Ticket List View    //
    //===============================-->
    <record id="view_helpdesk_ticket_tree_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">

            <!-- Odoo 19: Use 'list' tag -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="employee_ids"
                       widget="many2many_tags"
                       optional="show"
                       string="Employees"/>
            </xpath>

        </field>
    </record>


