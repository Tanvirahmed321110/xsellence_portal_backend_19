<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_xsellence_portal" model="ir.module.category">
        <field name="name">Xsellence Portal</field>
        <field name="description">Xsellence Portal Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_xsellence_portal" model="res.groups.privilege">
        <field name="name">Xsellence Portal</field>
        <field name="category_id" ref="xsellence_portal.category_xsellence_portal"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_general_employee" model="res.groups">
        <field name="name">General Employee</field>
        <field name="privilege_id" ref="xsellence_portal.privilege_xsellence_portal"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="xsellence_portal.privilege_xsellence_portal"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('xsellence_portal.group_general_employee'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="xsellence_portal.privilege_xsellence_portal"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('xsellence_portal.group_project_manager'))]"/>
    </record>
</odoo>
