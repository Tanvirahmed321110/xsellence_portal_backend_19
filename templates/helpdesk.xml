<odoo>
    <template id="helpdesk_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css?v=1"/>
        <t t-call="xsellence_portal.custom_layout">

            <section class="helpdesk  mt-sm-0">


                <!--==============|| Filter Header Here  ||================-->
                <div class="filter-head flex-between gap-5">
                    <!-- For Search -->
                    <div class="search">
                        <div class="search-wrap input-control">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input class="search-input" type="text" placeholder="Search name or id..."
                            />
                        </div>
                    </div>

                    <!-- right -->
                    <div class="right d-flex gap-4 align-center">
                        <select class="filter-select" id="filter-project" onchange="applyFilters()">
                            <option value="">All Projects</option>
                            <option>MIT</option>
                            <option>Dashboard Project</option>
                            <option>NADIA FURNITURE</option>
                            <option>Ultimate Organic Life Ltd</option>
                            <option>MIT</option>
                            <option>Dashboard Project</option>
                            <option>NADIA FURNITURE</option>
                            <option>Ultimate Organic Life Ltd</option>
                            <option>Dashboard Project</option>
                        </select>
                        <select class="filter-select" id="filter-month" onchange="applyFilters()">
                            <option value="">All Status</option>
                            <option value="2025-04">New</option>
                            <option value="2025-04">In Progress</option>
                            <option value="2025-04">Sloved</option>
                            <option value="2025-04">Canceled</option>
                            <option value="2025-04">All</option>
                        </select>

                        <a href="/helpdesk/create_ticket" class="btn btn-primary">Create Ticket
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="14"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="create-ticket-icon">
                                <path d="M2 9a3 3 0 0 0 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 0 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
                                <path d="M13 5v14"/>
                                <path d="M9 12h8"/>
                                <path d="M13 8v8"/>
                            </svg>
                        </a>
                    </div>
                </div>


                <!--==============|| Helpdesk Overview Cards Here  ||================-->
                <div class="card-items grid-4 grid-sm-2 gap-4 gap-sm-3 mt-6 mt-sm-5">

                    <!-- For New card: with SVG icon and count 12 -->
                    <div class="helpdesk-card new">
                        <div class="card-icon">
                            <!-- New SVG icon: sparkling + plus badge style (fresh ticket) -->
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#3b82f6" stroke-width="1.7" fill="none"/>
                                <path d="M12 7V17M7 12H17" stroke="#3b82f6" stroke-width="2" stroke-linecap="round"/>
                                <path d="M17 3L19 5L17 7" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                                <path d="M3 17L5 19L3 21" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h5>New</h5>
                            <span class="count" t-esc="count_new"></span>
                        </div>
                    </div>

                    <!-- For Progress card: with SVG icon (circular sync / progress arrows) -->
                    <div class="helpdesk-card progress">
                        <div class="card-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#f59e0b" stroke-width="1.7" fill="none"/>
                                <path d="M12 6V12L16 14" stroke="#f59e0b" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="M18 15L21 18L18 21" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                                <path d="M6 15L3 18L6 21" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h5>In Progress</h5>
                            <span class="count" t-esc="count_in_progress"></span>
                        </div>
                    </div>

                    <!-- For Solved card: originally empty div, now complete with SVG (check badge + resolved) -->
                    <div class="helpdesk-card sloved">
                        <div class="card-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#10b981" stroke-width="1.7" fill="none"/>
                                <path d="M8 12L11 15L16 9" stroke="#10b981" stroke-width="2" stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h5>Solved</h5>
                            <span class="count" t-esc="count_solved"></span>
                        </div>
                    </div>

                    <!-- For Cancelled card: originally empty, now added icon with cancel / X mark -->
                    <div class="helpdesk-card cancelled">
                        <div class="card-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="#ef4444" stroke-width="1.7" fill="none"/>
                                <path d="M8 8L16 16M16 8L8 16" stroke="#ef4444" stroke-width="2"
                                      stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h5>Cancelled</h5>
                            <span class="count " t-esc="count_cancelled"></span>
                        </div>
                    </div>
                </div>


                <!--==============|| Helpdesk Support Cards Here  ||================-->
                <div class="helpdesk-wrap mt-6 ">

                    <div class="">
                        <div class="h-items grid-4 gap-lg-4 grid-sm-2 gap-5  gap-sm-3">
                            <t t-foreach="tickets" t-as="ticket">
                                <!-- ==========  Single Helpdesk Item ========== -->
                               <a t-attf-href="/helpdesks/ticket_details/#{ticket.id}" class="item">
                                    <div class="ticket-header">
                                        <!-- ticket name -->
                                        <div class="task-name" t-esc="ticket.name"> </div>
                                        <div class="status"
                                             t-attf-class="status
                                             {{ 'status-new' if ticket.stage_id.name == 'New' else '' }}
                                             {{ 'status-progress' if ticket.stage_id.name == 'In Progress' else '' }}
                                             {{ 'status-solved' if ticket.stage_id.name == 'Solved' else '' }}
                                             {{ 'status-cancelled' if ticket.stage_id.name == 'Cancelled' else '' }}"
                                             t-esc="ticket.stage_id.name">
                                        </div>
                                    </div>

                                    <div>

                                    </div>

                                    <div class="card-info-grid grid-2 p-3 gap-2">
                                        <!-- Project Name -->
                                        <div class="info-item">
                                            <div class="info-label d-flex gap-1 align-center">Project
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1H3V6z"></path>
                                                    <path d="M3 10h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8z"></path>
                                                </svg>
                                            </div>
                                            <div class="info-val mt-1" t-esc="ticket.partner_id.name">
                                            </div>
                                        </div>
                                        <!-- For Assigned date -->
                                        <div class="info-item ">
                                            <div class="info-label">Deadline</div>
                                            <div class="info-val mt-1">
                                                <svg width="11" height="11" viewBox="0 0 24 24"
                                                     fill="none" stroke="#9ca3af" stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">
                                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                                </svg>
                                                <t t-esc="ticket.deadline"></t>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="footer-meta flex-between gap-2 px-3 pb-3 mt-2">
                                        <select class="filter-select">
                                            <option value="cancelled">Cancelled</option>
                                            <option value="active">Active</option>
                                            <option value="onhold">On Hold</option>
                                            <option value="blocked">Blocked</option>
                                            <option value="completed">Completed</option>
                                        </select>
                                        <!-- Assign By  -->
                                        <div class="info-item">
                                            <div class="info-label">Assigned By</div>
                                            <div class="info-val mt-1">
                                                <!-- Creator/Assigner er nam -->
                                                <t t-if="ticket.user_id">
                                                    <span t-esc="ticket.user_id.name"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">Unassigned</span>
                                                </t>

                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </t>
                            <!-- ==========  Single Helpdesk Item ========== -->
