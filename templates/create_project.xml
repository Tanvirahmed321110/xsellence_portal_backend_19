<odoo>
    <template id="create_project_page">
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Create Project ||=========================-->
            <section class="projects-wrap mt-4 flex-column">
                <div class="sec-title d-flex gap-2 align-center">Create New Project
                    <span
                            class="count fs-xs flex-center">+
                    </span>
                </div>


                <div class="d-flex flex-1 flex-center mt-6">
                    <form action="/submit_project" method="post" class="submit-form flex-column gap-5">

                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke-width="2" stroke="currentColor" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <!-- Document -->
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <path d="M14 2v6h6"/>

                                    <!-- Plus -->
                                    <path d="M12 11v6M9 14h6"/>
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Create New Project</div>
                                <p class="desc mt-1">Add the details of your new project (<span class="required">*
                                </span> are required.)
                                </p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Project Name =======-->
                            <div class="input-control">
                                <label for="name">Name
                                    <span class="required">*</span>
                                </label>
                                <input type="text" required="required" name="name" id="name"
                                       placeholder="Project Name"/>
                            </div>

                            <!--======= For Company Name =======-->
                            <div class="input-control">
                                <label for="partner_id" data-select-target="partner_id" class="select-open-label">
                                    Customer Name
                                </label>
                                <select name="partner_id" id="partner_id">
                                    <option value="">Select Customer</option>
                                    <t t-foreach="customers" t-as="customer">
                                        <option t-att-value="customer.id">
                                            <t t-esc="customer.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Project Manager =======-->
                            <div class="input-control">
                                <label for="user_id" data-select-target="user_id" class="select-open-label">Project
                                    Manager
                                    <span class="required">*</span>
                                </label>
                                <select name="user_id" id="user_id" required="required">
                                    <option value="">Select Manager</option>
                                    <t t-foreach="project_managers" t-as="manager">
                                        <option t-att-value="manager.id">
                                            <t t-esc="manager.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For  Status =======-->
                            <div class="input-control">
                                <label for="custom_status" data-select-target="custom_status" class="select-open-label">
                                    Project Status
                                </label>
                                <select name="custom_status" id="custom_status">
                                    <option disabled="disabled" value="Select Status">Select Status</option>
                                    <t t-foreach="status_selection" t-as="status">
                                        <option t-att-value="status[0]">
                                            <t t-esc="status[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Start Date =======-->
                            <div class="input-control">
                                <label for="date_start">Start Date
                                </label>
                                <input type="date" t-att-value="today" name="date_start" id="date_start"
                                       placeholder="Project Manager"/>
                            </div>

                            <!--======= For End Date =======-->
                            <div class="input-control">
                                <label for="date">End Date
                                    <span class="required">*</span>
                                </label>
                                <input type="date" required="required" name="date" id="date"
                                       placeholder="Company Name"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Assign Members =======-->
                            <div class="input-control">
                                <label for="assigned_user_ids">Assign Members
                                    <span class="required">*</span>
                                </label>
                                <select name="assigned_user_ids" required="required" id="assigned_user_ids"
                                        multiple="multiple">
                                    <t t-foreach="users" t-as="user">
                                        <option t-att-value="user.id">
                                            <t t-esc="user.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For Project Tags =======-->
                            <div class="input-control">
                                <label for="tag_ids">Tags
                                </label>
                                <select name="tag_ids" id="tag_ids" multiple="multiple">
                                    <t t-foreach="tags" t-as="tag">
                                        <option t-att-value="tag.id">
                                            <t t-esc="tag.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1">
                            <!--======= For  Status =======-->
                            <div class="input-control">
                                <label for="custom_priority" data-select-target="custom_priority"
                                       class="select-open-label">Project Priority
                                </label>
                                <select name="custom_priority" id="custom_priority">
                                    <t t-foreach="priority" t-as="item">
                                        <option t-att-value="item[0]">
                                            <t t-esc="item[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="description">Description</label>
                                <textarea name="description" id="description" placeholder="Description..."></textarea>
                            </div>
                        </div>

                        <!--======= For  Teamleader =======-->
                        <div class="my-mt-7 team-leader">
                            <div class=" fs-lg  fw-bold" style="color:#121212">For Team_leader</div>
                            <div class="grid-1 gap-5 grid-sm-1 mt-3">
                                <!--======= For git Link =======-->
                                <div class="input-control">
                                    <label for="github_link">Github Repo</label>
                                    <input name="github_link" id="github_link" placeholder="Github Link..."/>
                                </div>


                                <!--======= For Live =======-->
                                <div class="grid-3 gap-3 grid-sm-1">

                                    <!-- Dummy fields to block browser autofill -->
                                    <input type="text" style="display:none" autocomplete="username"/>
                                    <input type="password" style="display:none" autocomplete="current-password"/>

                                    <div class="input-control">
                                        <label for="live_link">Live Link</label>
                                        <input type="text"
                                               name="live_link"
                                               id="live_link"
                                               placeholder="Live Link..."
                                               autocomplete="off"/>
                                    </div>

                                    <div class="input-control">
                                        <label for="live_user">User</label>
                                        <input type="text"
                                               name="live_user"
                                               id="live_user"
                                               placeholder="User Type"
                                               autocomplete="off"/>
                                    </div>

                                    <div class="input-control">
                                        <label for="live_password">Live Password</label>
                                        <input type="password"
                                               name="live_password"
                                               id="live_password"
                                               placeholder="Live Password"
                                               autocomplete="new-password"/>
                                    </div>

                                </div>

                                <!--======= For Dev  =======-->
                                <div class="grid-3 gap-3 grid-sm-1">
                                    <div class="input-control">
                                        <label for="dev_link">Dev Link</label>
                                        <input name="dev_link" id="dev_link" placeholder="Dev Server Link..."/>
                                    </div>
                                    <div class="input-control">
                                        <label for="dev_user">Dev User</label>
                                        <input name="dev_user" id="dev_user" placeholder="Dev User"/>
                                    </div>
                                    <div class="input-control">
                                        <label for="dev_password">Dev Password</label>
                                        <input type="password" name="dev_password" id="dev_password"
                                               placeholder="Dev Password"/>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- <div id="toast" class="toast show error">
                            <span id="toast-msg">Submited Task</span>
                        </div> -->
                        <!-- <div id="toast" class="toast show success">
                            <span id="toast-msg">Error Message</span>
                        </div> -->

                        <!--======= For Rest and Sumbit Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <!-- Reset Button -->
                            <button class="btn btn-danger" type="reset">Reset
                                <svg width="12" height="12"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 12a9 9 0 1 1-3-6.7"></path>
                                    <path d="M21 3v6h-6"></path>
                                </svg>
                            </button>
                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary" style="gap:8px">Submit
                                <svg width="12"
                                     height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2 21l20-9L2 3v7l15 2-15 2z"/>
                                </svg>
                            </button>
                        </div>

                    </form>
                </div>
            </section>

            <!-- Ts Control Library CDN -->
            <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
            <script>
                // <!-- Ts Control Library Code -->
                new TomSelect("#assigned_user_ids", {
                create: true, // allow new names
                persist: false
                });

                new TomSelect("#tag_ids", {
                create: true, // allow new names
                persist: false
                });
            </script>
        </t>
    </template>
</odoo>