<odoo>
    <template id="edit_task_page">
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Projects Here ||=========================-->
            <section class="projects-wrap mt-4 flex-column">
                <div class="sec-title d-flex gap-2 align-center">Edit Task
                    <span
                            class="count fs-xs flex-center">+
                    </span>
                </div>


                <div class="d-flex flex-1 flex-center mt-6">
                    <form t-att-action="'/task/edit/%s' % task.id" method="post" class="submit-form flex-column gap-5">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Update Task</div>
                                <p class="desc mt-1">Add the details of your new task (<span class="required">*</span> are
                                    required.)
                                </p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Task Name =======-->
                            <div class="input-control">
                                <label for="">Task Name
                                    <span class="required">*</span>
                                </label>
                                <input type="text" name='name' t-att-value="task.name" required="1"
                                       placeholder="Task Name"/>
                            </div>

                            <!--======= For Project =======-->
                            <div class="input-control ">
                                <label for="">Project
                                    <span class="required">*</span>
                                </label>
                                <select name="project_id" required="required" id="">
                                    <option value="">Select Project</option>
                                    <t t-foreach="projects" t-as="project">
                                        <option t-att-value="project.id"
                                                t-att-selected="'selected' if project.id == task.project_id.id else None">
                                            <t t-esc="project.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">

                            <!--======= For Assign Date =======-->
                            <div class="input-control">
                                <label for="">Assigning Date</label>
                                <input type="date" readonly="1" name="date_assign"
                                       t-att-value="str(task.date_assign)[:10] if task.date_assign else ''"/>
                            </div>

                            <!--======= For Daedline =======-->
                            <div class="input-control">
                                <label for="">Deadline
                                    <span class="required">*</span>
                                </label>
                                <input type="date" name="date_deadline" required="required"
                                       t-att-value="str(task.date_deadline)[:10] if task.date_deadline else ''"/>
                            </div>
                        </div>


                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Allocation Hours =======-->
                            <div class="input-control">
                                <label for="">Priority</label>
                                <select name="custom_priority" id="custom_priority">
                                    <t t-foreach="priority" t-as="item">
                                        <option t-att-value="item[0]"
                                                t-att-selected="'selected' if item[0] == task.custom_priority else None">
                                            <t t-esc="item[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <!--======= For Status =======-->
                            <div class="input-control ">
                                <label for="">Task Status</label>
                                <select name="stage_id" id="stage_id">
                                    <t t-foreach="statuses" t-as="item">
                                        <option t-att-value="item.id"
                                                t-att-selected="'selected' if item.id == task.stage_id.id else None">
                                            <t t-esc="item.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For Assignee Names =======-->
                            <div class="input-control ">
                                <label for="">Assignee Names
                                    <span class="required">*</span>
                                </label>
                                <select name="user_ids" id="assignees" multiple="multiple">
                                    <t t-foreach="users" t-as="user">
                                        <option t-att-value="user.id"
                                                t-att-selected="'selected' if user in task.user_ids else None">
                                            <t t-esc="user.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="">Description</label>
                                <textarea name="description" placeholder="Description..."><t t-out="task_description"/></textarea>
                            </div>
                        </div>


                        <!--======= For Rest and Sumbit Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <!-- Reset button -->
                            <button class="btn btn-danger" type="reset">Reset

                                <svg width="16" height="14" viewBox="0 0 24 24" fill="none">
                                    <path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round"/>
                                    <path d="M21 3v6h-6" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round"/>
                                </svg>
                            </button>
                            <!-- submit button -->
                            <button type="submit" class="btn btn-primary" style="gap:8px">Update
                                <svg width="12"
                                     height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2 21l20-9L2 3v7l15 2-15 2z"/>
                                </svg>
                            </button>
                        </div>

                    </form>
                </div>
            </section>
            <!-- Ts Control Library CDN -->
            <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
            <script>
                new TomSelect("#assignees", {
                create: false,
                persist: false
                });

                new TomSelect("#stage_id", {
                create: true,
                persist: false
                });
            </script>
        </t>
    </template>
</odoo>
