<odoo>
    <template id="project_details_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css"/>
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Project Details Here ||=========================-->
            <section class="task-details mt-6">
                <div class="flex-center history-and-card">
                    <!--================||   Single Task Card here ||===============-->
                    <div class="proj-card task-card">
                        <div class="card-banner"></div>
                        <div class="card-body">
                            <div class="card-top">
                                <div class="card-title-wrap">
                                    <!-- Task Name -->
                                    <div class="card-proj-name" t-esc="project.name">Nadia Website Backend Development
                                    </div>
                                </div>
                                <!-- Status -->
                                <div>
                                    <div class="sts sts-default" t-esc="project.stage_id.name or 'N/A'"></div>
                                </div>
                            </div>
                            <div>
                                <div class="info-label d-flex align-center gap-2">Tags
                                    <svg width="19" height="17" viewBox="0 0 24 24" fill="none">
                                        <path d="M20 12L12 20L4 12V4H12L20 12Z" stroke="currentColor" stroke-width="2"
                                              stroke-linejoin="round"/>
                                        <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                                    </svg>
                                </div>

                                <!-- tag names -->
                                <div class="card-tags">
                                    <t t-foreach="project.tag_ids" t-as="tag" t-key="tag.id">
                                        <span class="tag" t-esc="tag.name"></span>
                                    </t>
                                </div>
                            </div>
                            <!-- assignee names -->
                            <div>
                                <div class="info-label d-flex align-center gap-2">Assignee
                                    <svg width="19" height="17" viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="8" r="3.5" fill="currentColor"/>
                                        <circle cx="6" cy="10" r="2.5" fill="currentColor" opacity="0.9"/>
                                        <circle cx="18" cy="10" r="2.5" fill="currentColor" opacity="0.9"/>
                                        <path d="M4 20c0-3.5 4-5.5 8-5.5s8 2 8 5.5" fill="currentColor"/>
                                    </svg>
                                </div>

                                <!-- assignee names -->
                                <div class="card-tags">
                                    <t t-foreach="project.assigned_user_ids" t-as="assign">
                                        <span class="tag " t-esc="assign.name"></span>
                                    </t>
                                </div>
                            </div>
                            <div class="card-info-grid mt-4">
                                <!-- Project Name -->
                                <div class="info-item mt-2">
                                    <div class="info-label d-flex ailign-center gap-1">Project
                                        <svg width="18"
                                             height="17" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1H3V6z"></path>
                                            <path d="M3 10h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8z"></path>
                                        </svg>
                                    </div>
                                    <div class="info-val mt-1" t-esc="project.partner_id.name">Nutrition Depot BD
                                    </div>
                                </div>

                                <!-- For Assigned date -->
                                <div class="info-item mt-2">
                                    <div class="info-label">Created Date</div>
                                    <div class="info-val mt-1">
                                        <svg width="11" height="11" viewBox="0 0 24 24"
                                             fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <t t-esc="project.date_start"/>
                                    </div>
                                </div>
                            </div>

                            <div class="card-info-grid">

                                <!-- For Project Priority -->
                                <div class="card-manager">
                                    <div class="manager-info mt-2">
                                        <div class="info-label">Priority
                                            <svg width="18" height="16" viewBox="0 0 24 24"
                                                 fill="currentColor">
                                                <path d="M4 2v20" stroke="currentColor" stroke-width="2"
                                                      stroke-linecap="round"/>
                                                <path d="M4 3h13l-2 4 2 4H4z"/>
                                            </svg>

                                        </div>
                                        <div class=" info-val" t-esc="project.custom_priority">High</div>
                                    </div>
                                </div>

                                <!-- For Deadline -->
                                <div class="info-item mt-2">
                                    <div class="info-label">Deadline</div>
                                    <div class="info-val mt-1">
                                        <svg width="11" height="11" viewBox="0 0 24 24"
                                             fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span>
                                            <t t-esc="project.date"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-info-grid">

                                <!-- For Allocated -->
                                <div class="info-item mt-2">
                                    <div class="info-label">Allocated Time</div>
                                    <div class="info-val mt-1">
                                        <svg width="11" height="11" viewBox="0 0 24 24"
                                             fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span t-esc="project.allocated_hours"></span>
                                    </div>
                                </div>

                                <!-- Total Task -->
                                <div class="card-manager">
                                    <div class="manager-info mt-2">
                                        <div class="info-label align-center gap-1">Total Tasks
                                            <svg width="18"
                                                 height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M9 5h12v2H9zM9 11h12v2H9zM9 17h12v2H9z"/>
                                                <path d="M4 6l1.5 1.5L8 5l-1-1-1.5 1.5L4 4z"/>
                                                <path d="M4 12l1.5 1.5L8 11l-1-1-1.5 1.5L4 10z"/>
                                                <path d="M4 18l1.5 1.5L8 17l-1-1-1.5 1.5L4 16z"/>
                                            </svg>

                                        </div>
                                        <div class=" info-val" t-esc="project.task_count"></div>
                                    </div>
                                </div>
                            </div>


                            <div class="card-info-grid">
                                <!-- Total Task -->
                                <div class="card-manager">
                                    <div class="manager-info mt-2">
                                        <div class="info-label align-center gap-1">Project Manager
                                        </div>
                                        <div class=" info-val" t-esc="project.user_id.name"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Task Description -->
                            <div class="mt-4">
                                <t t-if="project.description">
                                    <div class="info-label">Description</div>
                                    <div class="task-desc-wrap mt-2 flex-column gap-4" t-esc="project.description">

                                        <!-- <img class="radius-md" src="/images/bg.jpg" alt="project details image" />-->
                                    </div>
                                </t>
                            </div>

                            <div class="team-leader mt-5">
                                <div class="fs-lg fw-bold" style="color:#121212;">Useful Links:</div>
                                <div class="d-flex align-center mt-4 gap-4">
                                    <span style="min-width:90px;display:inline-block;font-weight:500;color:var(--color-primary)">
                                        Github Repo:
                                    </span>
                                    <t t-if="project.github_link">
                                        <a t-att-href="project.github_link" target="_blank">Github Link</a>
                                    </t>
                                </div>


                                <div class="grid-3  gap-3 mt-4">

                                    <!-- Dev Link -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Dev Link:
                                        </span>
                                        <t t-if="project.dev_link">
                                            <a t-att-href="project.dev_link" target="_blank">Dev Server Link</a>
                                        </t>
                                    </div>

                                    <!-- Dev User -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Dev User:
                                        </span>
                                        <t t-if="project.dev_user">
                                            <p t-esc="project.dev_user" style="padding:2px 4px;background:#ededed;color:var(--color-text-desc)">Dev User</p>
                                        </t>
                                    </div>

                                    <!-- Dev Password -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Dev Password:
                                        </span>
                                        <t t-if="project.dev_password">
                                            <p t-esc="project.dev_password" style="padding:2px 4px;background:#ededed;color:var(--color-text-desc)">Dev Password</p>
                                        </t>
                                    </div>
                                </div>

                                <div class="grid-3 gap-3 mt-3" style="border-top:1px solid #ededed;padding-top:12px">
                                     <!-- Live Link -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Live Link:
                                        </span>
                                        <t t-if="project.live_link">
                                            <a t-att-href="project.live_link" target="_blank">Live Link</a>
                                        </t>
                                    </div>

                                    <!-- Live User -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Live User:
                                        </span>
                                        <t t-if="project.live_user">
                                            <p t-esc="project.live_user" style="padding:2px 4px;background:#ededed;color:var(--color-text-desc)">Live User</p>
                                        </t>
                                    </div>

                                    <!-- Live Password -->
                                    <div class="d-flex align-center gap-4">
                                        <span style="min-width:90px;display:inline-block;color:var(--color-primary);font-weight:500">
                                            Live Password:
                                        </span>
                                        <t t-if="project.live_password">
                                            <p t-esc="project.live_password" style="padding:2px 4px;background:#ededed;color:var(--color-text-desc)">Live Password</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--=============  Card Footer  =============-->
                        <div class="card-footer">
                            <t t-if="can_manage_projects">
                                <form method="post" action="/project/update_status">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="project_id" t-att-value="project.id"/>

                                    <div class="state-dropdown">
                                        <select class="filter-select" name="status" onchange="this.form.submit()">
                                            <t t-foreach="status_selection" t-as="status">
                                                <option t-att-value="status.id"
                                                        t-att-selected="status.id == project.stage_id.id">
                                                    <t t-esc="status.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </form>
                            </t>
                            <t t-else="">
                                <div class="state-dropdown">
                                    <div class="filter-select" t-esc="project.stage_id.name or 'N/A'"></div>
                                </div>
                            </t>


                            <!-- Actions Buttons -->
                            <t t-if="can_manage_projects">
                                <div class="action-btns">

                                <!-- Edit button -->
                                <a t-att-href="'/project/edit/%s' % project.id" class="action-btn edit">
                                    Edit
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9"/>
                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                                    </svg>
                                </a>

                                <form method='post' action="/project/delete">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="project_id" t-att-value="project.id"/>

                                    <!-- Delete button -->
                                    <button type="submit" class="action-btn del" onclick="return openDeleteModal(this)">
                                        <svg width="12" height="12" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                            <path d="M10 11v6"/>
                                            <path d="M14 11v6"/>
                                            <path d="M9 6V4h6v2"/>
                                        </svg>
                                    </button>
                                </form>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!--================||   History/Log Card Here  ||===============-->
                    <div class="history-sidebar">
                        <div class="history-header">
                            <h5>🕓 Activity Log</h5>
                            <span class="history-count" t-esc="len(messages)"/>
                        </div>

                        <div class="history-composer">

                            <!-- submit message -->
                            <form t-att-action="'/project/comment/%s' % project.id"
                                  method="post"
                                  class="history-comment-form">

                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <textarea name="comment"
                                          placeholder="Log a note or update..."
                                          required="required"></textarea>

                                <div class="composer-actions">
                                    <button type="submit" class="btn btn-post btn-primary">
                                        POST
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="history-body">

                            <t t-foreach="messages" t-as="msg">
                                <t t-if="msg.tracking_value_ids">
                                    <t t-foreach="msg.tracking_value_ids" t-as="track">

                                        <t t-set="avatar_class" t-value="'av-6'"/>
                                        <t t-set="tag_class" t-value="'tag-update'"/>
                                        <t t-set="tag_label" t-value="'Updated'"/>

                                        <t t-if="track.field_id.name == 'stage_id'">
                                            <t t-set="avatar_class" t-value="'av-1'"/>
                                            <t t-set="tag_class" t-value="'tag-status'"/>
                                            <t t-set="tag_label" t-value="'Status Changed'"/>
                                        </t>

                                        <t t-elif="track.field_id.name == 'custom_priority'">
                                            <t t-set="avatar_class" t-value="'av-2'"/>
                                            <t t-set="tag_class" t-value="'tag-priority'"/>
                                            <t t-set="tag_label" t-value="'Priority Changed'"/>
                                        </t>

                                        <t t-elif="track.field_id.name == 'user_id'">
                                            <t t-set="avatar_class" t-value="'av-3'"/>
                                            <t t-set="tag_class" t-value="'tag-manager'"/>
                                            <t t-set="tag_label" t-value="'Manager Changed'"/>
                                        </t>

                                        <t t-elif="track.field_id.name == 'assigned_user_ids'">
                                            <t t-set="avatar_class" t-value="'av-4'"/>
                                            <t t-set="tag_class" t-value="'tag-assignee'"/>
                                            <t t-set="tag_label" t-value="'Assignee Changed'"/>
                                        </t>

                                        <t t-elif="track.field_id.name in ['date_deadline', 'date_start', 'date']">
                                            <t t-set="avatar_class" t-value="'av-5'"/>
                                            <t t-set="tag_class" t-value="'tag-date'"/>
                                            <t t-set="tag_label" t-value="'Date Changed'"/>
                                        </t>

                                        <div class="history-item">
                                            <div t-attf-class="history-avatar #{avatar_class}"
                                                 t-esc="(msg.author_id.name or 'A')[0].upper()"/>

                                            <div class="history-content">
                                                <div class="history-meta">
                                                    <span class="history-author"
                                                          t-esc="msg.author_id.name or 'System'"/>
                                                    <span class="history-date"
                                                          t-esc="msg.date.strftime('%d %b %Y %I:%M%p') if msg.date else ''"/>
                                                </div>

                                                <div class="history-text">
                                                    Changed
                                                    <b t-esc="track.field_id.field_description"/>
                                                    from
                                                    <b t-esc="track.old_value_char or track.old_value_integer or track.old_value_datetime or '-'"/>
                                                    to
                                                    <b t-esc="track.new_value_char or track.new_value_integer or track.new_value_datetime or '-'"/>
                                                    .
                                                </div>
                                                <div class="history-text" t-raw="msg.body or ''"/>

                                                <span t-attf-class="history-tag #{tag_class}" t-esc="tag_label"/>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <!--=========  When Empty ========-->
                                <t t-else="">
                                    <div class="history-item">
                                        <div class="history-avatar av-6"
                                             t-esc="(msg.author_id.name or 'A')[0].upper()"/>

                                        <div class="history-content">
                                            <div class="history-meta">
                                                <span class="history-author" t-esc="msg.author_id.name or 'System'"/>
                                                <span class="history-date"
                                                      t-esc="msg.date.strftime('%d %b %Y %I:%M%p').replace('AM', 'am').replace('PM', 'pm') if msg.date else ''"/>
                                            </div>

                                            <div class="history-text" t-raw="msg.body or ''"/>

                                            <span class="history-tag tag-note">Comment</span>
                                        </div>
                                    </div>
                                </t>
                            </t>


                        </div>
                    </div>
                </div>

                <!-- =====  Delete Modal  ===== -->
                <t t-if="can_manage_projects">
                <div class="modal-overlay " id="deleteModal">
                    <div class="modal-container">
                        <div class="glass-icon">🗑️</div>
                        <h3>Delete Project?</h3>
                        <p>
                            This action cannot be undone.
                            <br/>
                            The Project will be permanently removed.
                        </p>

                        <div class="glass-actions">
                            <button type="button" id="confirmYes" class="btn-glass-yes">
                                Yes, Delete
                            </button>
                            <button class="btn-glass-no" onclick="closeModal('deleteModal')">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
                </t>
            </section>
        </t>
    </template>
</odoo>
