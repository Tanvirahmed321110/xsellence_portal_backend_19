<odoo>
    <template id="add_task_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css"/>
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Projects Here ||=========================-->
            <section class="projects-wrap mt-4 flex-column" style="perspective: 1200px;">
                <div class="sec-title d-flex gap-2 align-center">Add New Task
                    <span
                            class="count fs-xs flex-center">+
                    </span>
                </div>


                <div class="d-flex flex-1 flex-center mt-6" style="transform-style: preserve-3d;">
                    <form action="/add_task/submit" method="post" class="submit-form flex-column gap-5">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                    <path d="M2 17l10 5 10-5"></path>
                                    <path d="M2 12l10 5 10-5"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Add New Task</div>
                                <p class="desc mt-1">Add the details of your new task (<span class="required">*</span> are
                                    required.)
                                </p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Task Name =======-->
                            <div class="input-control">
                                <label for="name">Task Name
                                    <span class="required">*</span>
                                </label>
                                <input type="text" name='name' id="name" required="1" placeholder="Task Name"/>
                            </div>

                            <!--======= For Project =======-->
                            <div class="input-control ">
                                <label for="project_id" data-select-target="project_id" class="select-open-label">
                                    Project
                                    <span class="required">*</span>
                                </label>
                                <select name="project_id" required="required" id="project_id">
                                    <option value="">Select Project</option>
                                    <t t-foreach="projects" t-as="project">
                                        <option t-att-value="project.id"
                                                t-att-selected="'selected' if selected_project_id and selected_project_id == project.id else None"
                                                t-esc="project.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">

                            <!--======= For Assign Date =======-->
                            <div class="input-control">
                                <label for="">Assigning Date</label>
                                <input type="date" t-att-value="today" readonly='1' name="date_assign"/>
                            </div>

                            <!--======= For Deadline =======-->
                            <div class="input-control">
                                <label for="date_deadline">Deadline
                                    <span class="required">*</span>
                                </label>
                                <input type="date" id="date_deadline" name="date_deadline" required="required" t-att-min="today"/>
                            </div>
                        </div>


                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Allocation Hours =======-->
                            <div class="input-control">
                                <label for="custom_priority" data-select-target="custom_priority"
                                       class="select-open-label">Priority
                                </label>
                                <select name="custom_priority" id="custom_priority">
                                    <t t-foreach="priority" t-as="item">
                                        <option t-att-value="item[0]">
                                            <t t-esc="item[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <!--======= For Status =======-->
                            <div class="input-control ">
                                <label for="stage_id" data-select-target="stage_id" class="select-open-label">
                                    Task Status
                                </label>
                                <select name="stage_id" id="stage_id">
                                    <t t-foreach="statuses" t-as="item">
                                        <option t-att-value="item.id">
                                            <t t-esc="item.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For Assignee Names =======-->
                            <div class="input-control ">
                                <label for="assignees">Assignee Names
                                    <span class="required">*</span>
                                </label>
                                <select name="user_ids" id="assignees" multiple="multiple">
                                    <t t-foreach="users" t-as="user">
                                        <option t-att-value="user.id" t-esc="user.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="description">Description</label>
                                <textarea name="description" id="description" placeholder="Description..."></textarea>
                            </div>
                        </div>

                        <!-- <div id="toast" class="toast show error">
                            <span id="toast-msg">Submited Task</span>
                        </div> -->
                        <!-- <div id="toast" class="toast show success">
                            <span id="toast-msg">Error Message</span>
                        </div> -->


                        <!--======= For Rest and Sumbit Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <!-- Reset button -->
                            <button class="btn btn-danger" type="reset">Reset

                                <svg width="16" height="14" viewBox="0 0 24 24" fill="none">
                                    <path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round"/>
                                    <path d="M21 3v6h-6" stroke="currentColor" stroke-width="2"
                                          stroke-linecap="round"/>
                                </svg>
                            </button>
                            <!-- submit button -->
                            <button type="submit" class="btn btn-primary" style="gap:8px">Submit
                                <svg width="12"
                                     height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2 21l20-9L2 3v7l15 2-15 2z"/>
                                </svg>
                            </button>
                        </div>

                    </form>
                </div>
            </section>
            <!-- Ts Control Library CDN -->
            <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
            <script>
                // <!-- Ts Control Library Code -->
                new TomSelect("#assignees", {
                create: true, // allow new names
                persist: false
                });

                new TomSelect("#stage_id", {
                create: true,
                persist: false
                });
            </script>
        </t>
    </template>
</odoo>
