<odoo>
    <template id="timesheet_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css?v=4"/>
        <t t-call="xsellence_portal.custom_layout">
            <t t-set="selected_employee_param" t-value="str(selected_employee_id) if selected_employee_id else ''"/>
            <t t-set="timesheet_filter_onchange"
               t-value='("const project=document.getElementById(\"filter-project\")?.value||\"\"; const startDate=document.getElementById(\"filter-start-date\")?.value||\"\"; const endDate=document.getElementById(\"filter-end-date\")?.value||\"\"; if(startDate &amp;&amp; endDate &amp;&amp; startDate > endDate){ alert(\"From date cannot be greater than To date.\"); return; } const params=new URLSearchParams(); if(project){params.set(\"project_id\", project);} if(startDate){params.set(\"start_date\", startDate);} if(endDate){params.set(\"end_date\", endDate);} if(\"%s\"){params.set(\"employee_id\", \"%s\");} const queryString=params.toString(); window.location.href=queryString ? \"/timesheets?\" + queryString : \"/timesheets\";" % (selected_employee_param, selected_employee_param))'/>

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Timesheets Here ||=========================-->
            <section class="projects-wrap mt-4 mt-sm-2">
                <div class="flex-between flex-wrap gap-4">
                    <div class="sec-title d-flex gap-2 align-center">Timesheets Tasks
                        <span
                                class="count fs-xs flex-center" t-esc="total">
                        </span>
                    </div>
                    <!-- add new timesheet button -->
                    <a class="btn btn-primary"
                       t-att-href="'/add_timesheet?source=timesheets&amp;employee_id=%s' % selected_employee_param if selected_employee_param else '/add_timesheet?source=timesheets'">Add New Timesheet +</a>
                </div>


                <!-- Timesheets Cards Here -->
                <div class="timesheets-cards">
                    <div class="card">

                    </div>
                </div>

                <div class="timesheets mt-6">
                    <div class="filter-head flex-between gap-5">
                        <!--  Filter By Project-->
                        <select class="filter-select"
                                id="filter-project"
                                name="project_id"
                                t-att-onchange="timesheet_filter_onchange">

                            <option value=""
                                    t-att-selected="'selected' if not selected_project_id else None">
                                Filter by Project
                            </option>

                            <t t-foreach="project_filter_options" t-as="project">
                                <option t-att-value="project.id"
                                        t-att-selected="'selected' if selected_project_id == project.id else None">
                                    <t t-esc="project.name"/>
                                </option>
                            </t>
                        </select>

                        <!-- right -->
                        <div class="right d-flex gap-4 align-center">


                            <div class="right d-flex gap-4 align-center">
                                <div class="date-search">
                                    <div class="date-filter-control">
                                        <label for="filter-start-date">From</label>
                                        <input type="date"
                                               id="filter-start-date"
                                               name="start_date"
                                               class="filter-date"
                                               t-att-value="selected_start_date or ''"/>
                                    </div>

                                    <div class="date-filter-control">
                                        <label for="filter-end-date">To </label>
                                        <input type="date"
                                               id="filter-end-date"
                                               name="end_date"
                                               class="filter-date"
                                               t-att-value="selected_end_date or ''"/>
                                    </div>
                                    <button class="filter-apply-btn" type="button"
                                            t-att-onclick="timesheet_filter_onchange">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!--=====================|| Timesheet Items Here (for 1 page show 12 or 15 items )  ||=======================-->
                    <div class="table-wrap mt-5 ">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Project</th>
                                    <th>Task</th>
                                    <th>Description</th>
                                    <th>Time Spent</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="timesheets" t-as="item">
                                    <tr>
                                        <td t-esc="item.date"></td>
                                        <td>
                                            <t t-esc="item.project_id.name or '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="item.task_id.name or '-'"/>
                                        </td>
                                        <td>
                                            <div class="tooltip timesheet-desc-tooltip">
                                                <div class="timesheet-desc-clamp">
                                                    <t t-esc="item.name or '-'"/>
                                                </div>
                                                <span class="tooltip-text" t-esc="item.name or '-'"></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="time-spent" t-field="item.unit_amount"
                                                  t-options="{'widget': 'float_time'}"/>
                                        </td>
                                        <td>
                                            <!-- Delete button -->
                                            <form method="post" action="/timesheets/delete">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="timesheet_id" t-att-value="item.id"/>
                                                <button type="button" class="action-btn del"
                                                        onclick="return openDeleteModal(this)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                        <path d="M10 11v6"/>
                                                        <path d="M14 11v6"/>
                                                        <path d="M9 6V4h6v2"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>

                                <!--  When Empty Timesheets-->
                                <t t-if="not timesheets">
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-timesheet-box">
                                                <div class="empty-timesheet-icon">
                                                    <svg width="42" height="42" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                                                        <path d="M16 2v4"></path>
                                                        <path d="M8 2v4"></path>
                                                        <path d="M3 10h18"></path>
                                                        <path d="M9 15h6"></path>
                                                        <path d="M9 18h3"></path>
                                                    </svg>
                                                </div>

                                                <h4>No timesheets found</h4>
                                                <p>You have not submitted any timesheet yet.</p>

                                                <a t-att-href="'/add_timesheet?source=timesheets&amp;employee_id=%s' % selected_employee_param if selected_employee_param else '/add_timesheet?source=timesheets'" class="empty-timesheet-btn">
                                                    Add Timesheet
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </t>

                                <!-- =====  Delete Modal  ===== -->
                                <div class="modal-overlay " id="deleteModal">
                                    <div class="modal-container">
                                        <div class="glass-icon">🗑️</div>
                                        <h3>Delete Timesheet?</h3>
                                        <p>
                                            This action cannot be undone.
                                            <br/>
                                            The timesheet will be permanently removed.
                                        </p>

                                        <div class="glass-actions">
                                            <button type="button" id="confirmYes" class="btn-glass-yes">
                                                Yes, Delete
                                            </button>
                                            <button class="btn-glass-no" onclick="closeModal('deleteModal')">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </tbody>
                        </table>
                    </div>

                    <!-- ===== Loading Overlay ===== -->
                    <div id="timesheetLoader" class="timesheet-loader">
                        <div class="loader-box">
                            <div class="loader-spinner"></div>
                            <p>Loading timesheets...</p>
                        </div>
                    </div>
                </div>

            </section>


            <!-- Pagination -->
            <t t-call="xsellence_portal.reusable_pagination"/>
        </t>

        <script src="/xsellence_portal/static/src/js/timesheet.js?v=2"></script>
    </template>
</odoo>
