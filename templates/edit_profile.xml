<odoo>
    <template id="edit_profile_page">
        <t t-call="xsellence_portal.custom_layout">

              <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>


            <section class="profile">
                <div class="d-flex flex-1 flex-center mt-6">
                    <form action="#" method="post" class="submit-form flex-column gap-5">
                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 17.25V21h3.75L19.81 7.94l-3.75-3.75L3 17.25z" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M14.06 4.19l3.75 3.75" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Edit Profile</div>
                                <p class="desc mt-1">Add the details of your new timesheet</p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Name =======-->
                            <div class="input-control">
                                <label for=""> Photo <span class="required">*</span></label>
                                <input type="file" />
                            </div>

                            <!--======= For Phone =======-->
                            <div class="input-control">
                                <label for=""> Name <span class="required">*</span></label>
                                <input type="text" placeholder="Name"/>
                            </div>
                        </div>
                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Name =======-->
                            <div class="input-control">
                                <label for=""> Phone <span class="required">*</span></label>
                                <input type="text" placeholder="Phone"/>
                            </div>

                            <!--======= For Phone =======-->
                            <div class="input-control">
                                <label for=""> Email <span class="required">*</span></label>
                                <input type="text" placeholder="Email"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Name =======-->
                            <!-- <div class="input-control">
                                <label for=""> Photo <span class="required">*</span></label>
                                <input type="file" placeholder="Email">
                            </div> -->

                            <!--======= For Phone =======-->
                            <div class="input-control">
                                <label for=""> Blood Group <span class="required">*</span></label>
                                <input type="text" placeholder="Name"/>
                            </div>
                            <!--======= For Phone =======-->
                            <div class="input-control">
                                <label for=""> Date of Birth <span class="required">*</span></label>
                                <input type="date"/>
                            </div>
                        </div>



                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="">Address</label>
                                <textarea name="" id="" placeholder="Address..."></textarea>
                            </div>
                        </div>



                        <!-- <div id="toast" class="toast show error">
                            <span id="toast-msg">Submited Task</span>
                        </div> -->
                        <!-- <div id="toast" class="toast show success">
                            <span id="toast-msg">Error Message</span>
                        </div> -->

                        <!--======= For Rest and Sumbit Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <!-- Reset Button -->
                            <button class="btn btn-danger" type="reset">Reset <svg width="12" height="12"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 12a9 9 0 1 1-3-6.7"></path>
                                    <path d="M21 3v6h-6"></path>
                                </svg></button>
                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary" style="gap:8px">Submit <svg width="12"
                                    height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2 21l20-9L2 3v7l15 2-15 2z"></path>
                                </svg></button>
                        </div>

                    </form>
                </div>
            </section>
        </t>
    </template>
</odoo>