<odoo>
    <template id="edit_project_page">
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Create Project ||=========================-->
            <section class="projects-wrap mt-4 flex-column">
                <div class="sec-title d-flex gap-2 align-center">Edit Project
                    <span
                            class="count fs-xs flex-center">+
                    </span>
                </div>


                <div class="d-flex flex-1 flex-center mt-6">
                    <form t-attf-action="/project/edit/#{project.id}" method="POST"
                          class="submit-form flex-column gap-5">

                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Update Project</div>
                                <p class="desc mt-1">Update the details of your project
                                    (<span class="required">*</span> are required.)
                                </p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Project Name =======-->
                            <div class="input-control">
                                <label for="name">Name
                                    <span class="required">*</span>
                                </label>
                                <input type="text" t-att-value="project.name" required="required" name="name" id="name"
                                       placeholder="Project Name"/>
                            </div>

                            <!--======= For Company Name =======-->
                            <div class="input-control">
                                <label for="partner_id">Customer Name
                                </label>
                                <select name="partner_id" id="partner_id" required="required">
                                    <option value="Select Project">Select Customer</option>
                                    <t t-foreach="customers" t-as="customer">
                                        <option t-att-value="customer.id"
                                                t-att-selected="'selected' if customer.id == project.partner_id.id else None">
                                            <t t-esc="customer.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Project Manager =======-->
                            <div class="input-control">
                                <label for="user_id">Project Manager
                                    <span class="required">*</span>
                                </label>
                                <select name="user_id" id="user_id" required="required">
                                    <option value="Select Manager">Select Manager</option>
                                    <t t-foreach="project_managers" t-as="manager">
                                        <option t-att-value="manager.id"
                                                t-att-selected="'selected' if manager.id == project.user_id.id else None">
                                            <t t-esc="manager.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For  Status =======-->
                            <div class="input-control">
                                <label for="stage_id">Project Status
                                </label>
                                <select name="stage_id" id="stage_id">
                                    <option disabled="disabled" value="Select Status">Select Status</option>
                                    <t t-foreach="status_selection" t-as="status">
                                        <option t-att-value="status.id"
                                                t-att-selected="'selected' if status.id == project.stage_id.id else None">
                                            <t t-esc="status.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Start Date =======-->
                            <div class="input-control">
                                <label for="date_start">Start Date
                                </label>
                                <input type="date" t-att-value="str(project.date_start) if project.date_start else ''"
                                       name="date_start" id="date_start" placeholder="Project Manager"/>
                            </div>

                            <!--======= For End Date =======-->
                            <div class="input-control">
                                <label for="date">End Date
                                    <span class="required">*</span>
                                </label>
                                <input type="date" t-att-value="str(project.date) if project.date else ''" name="date"
                                       id="date" placeholder="Company Name"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Assign Members =======-->
                            <div class="input-control">
                                <label for="assigned_user_ids">Assign Members
                                    <span class="required">*</span>
                                </label>
                                <select name="assigned_user_ids" required="required" id="assigned_user_ids"
                                        multiple="multiple">
                                    <t t-foreach="users" t-as="user">
                                        <option t-att-value="user.id"
                                                t-att-selected="'selected' if user.id in project.assigned_user_ids.ids else None">
                                            <t t-esc="user.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!--======= For Project Tags =======-->
                            <div class="input-control">
                                <label for="tag_ids">Tags
                                </label>
                                <select name="tag_ids" id="tag_ids" multiple="multiple">
                                    <t t-foreach="tags" t-as="tag">
                                        <option t-att-value="tag.id"
                                                t-att-selected="'selected' if tag.id in project.tag_ids.ids else None">
                                            <t t-esc="tag.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1">
                            <!--======= For  Status =======-->
                            <div class="input-control">
                                <label for="custom_priority">Project Priority
                                </label>
                                <select name="custom_priority" id="custom_priority">
                                    <t t-foreach="priority" t-as="item">
                                        <option t-att-value="item[0]"
                                                t-att-selected="'selected' if item[0] == project.custom_priority else None">
                                            <t t-esc="item[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="description">Description</label>
                                <textarea name="description" placeholder="Description..."><t t-out="project_desc"/> </textarea>
                            </div>
                        </div>

                        <!--======= For  Teamleader =======-->
                        <div class="fs-lg fw-bold mb-2" style="color:#121212;">For Team Leader</div>
                        <div class="grid-1 gap-5 grid-sm-1 mt-3">

                            <!--======= For Github Link =======-->
                            <div class="input-control">
                                <label for="github_link">Github Repo</label>
                                <input name="github_link" id="github_link"
                                       t-att-value="project.github_link"
                                       placeholder="Github Link..."/>
                            </div>

                            <!--======= For Live =======-->
                            <div class="grid-3 gap-3 grid-sm-1">
                                <div class="input-control">
                                    <label for="live_link">Live Link</label>
                                    <input name="live_link" id="live_link"
                                           t-att-value="project.live_link"
                                           placeholder="Live Link..."/>
                                </div>
                                <div class="input-control">
                                    <label for="live_user">User</label>
                                    <input name="live_user" id="live_user"
                                           t-att-value="project.live_user"
                                           placeholder="User Type"/>
                                </div>
                                <div class="input-control">
                                    <label for="live_password">Live Password</label>
                                    <input type="password" name="live_password" id="live_password"
                                           t-att-value="project.live_password"
                                           placeholder="Live Password"/>
                                </div>
                            </div>

                            <!--======= For Dev =======-->
                            <div class="grid-3 gap-3 grid-sm-1">
                                <div class="input-control">
                                    <label for="dev_link">Dev Link</label>
                                    <input name="dev_link" id="dev_link"
                                           t-att-value="project.dev_link"
                                           placeholder="Dev Server Link..."/>
                                </div>
                                <div class="input-control">
                                    <label for="dev_user">Dev User</label>
                                    <input name="dev_user" id="dev_user"
                                           t-att-value="project.dev_user"
                                           placeholder="Dev User"/>
                                </div>
                                <div class="input-control">
                                    <label for="dev_password">Dev Password</label>
                                    <input type="password" name="dev_password" id="dev_password"
                                           t-att-value="project.dev_password"
                                           placeholder="Dev Password"/>
                                </div>
                            </div>
                        </div>


                        <!--======= For Update Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <button type="submit" class="btn btn-primary"
                                    style="gap:8px; display:inline-flex; align-items:center;">
                                Update Project
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                        </div>

                    </form>
                </div>
            </section>

            <!-- Ts Control Library CDN -->
            <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
            <script>
                // <!-- Ts Control Library Code -->
                new TomSelect("#assigned_user_ids", {
                create: true, // allow new names
                persist: false
                });

                new TomSelect("#tag_ids", {
                create: true, // allow new names
                persist: false
                });

                new TomSelect("#stage_id", {
                create: true,
                persist: false
                });
            </script>
        </t>
    </template>
</odoo>
