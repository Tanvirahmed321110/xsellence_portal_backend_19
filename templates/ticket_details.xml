<odoo>
    <template id="ticket_details_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css?v=1"/>
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <section class="helpdesk-details mt-6">
                <!-- Page -->
                <div class="page">

                    <!-- Hero -->
                    <div class="ticket-hero">
                        <div class="hero-top">
                            <div style="flex:1;min-width:0;">
                                <div class="ticket-id-badge">
                                    ID:
                                    #
                                    <t t-esc="ticket.ticket_ref"></t>
                                </div>
                                <div class="ticket-title" t-esc="ticket.name"></div>
                                <div class="hero-badges">
                                    <div class="status"
                                         t-attf-class="status
                                             {{ 'status-new' if ticket.stage_id.name == 'New' else '' }}
                                             {{ 'status-progress' if ticket.stage_id.name == 'In Progress' else '' }}
                                             {{ 'status-solved' if ticket.stage_id.name == 'Solved' else '' }}
                                             {{ 'status-cancelled' if ticket.stage_id.name == 'Cancelled' else '' }}"
                                         t-esc="ticket.stage_id.name">
                                    </div>

                                    <!-- Ticket Priority Here-->
                                    <t t-if="ticket.priority == '1'">
                                        <span class="badge badge-normal">
                                            <span class="badge-dot"></span>Normal Priority
                                        </span>
                                    </t>
                                    <t t-elif="ticket.priority == '2'">
                                        <span class="badge badge-high">
                                            <span class="badge-dot"></span>High Priority
                                        </span>
                                    </t>
                                    <t t-elif="ticket.priority == '3'">
                                        <span class="badge badge-urgent">
                                            <span class="badge-dot"></span>Urgent Priority
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge badge-low">
                                            <span class="badge-dot"></span>Low Priority
                                        </span>
                                    </t>
                                </div>
                            </div>


                            <div class="hero-actions">
                                <!-- Mark Solved -->
                                <form action="/helpdesks/update_stage" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="ticket_id" t-att-value="ticket.id"/>

                                    <select class="filter-select" name="stage_id" onchange="this.form.submit()"
                                            style="width:100%;max-width:100%">
                                        <t t-foreach="(ticket.team_id.stage_ids or stages)" t-as="stage">
                                            <option t-att-value="stage.id"
                                                    t-att-selected="'selected' if ticket.stage_id.id == stage.id else None"
                                                    t-esc="stage.name"/>
                                        </t>
                                    </select>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Two-column -->
                    <div class="detail-grid" style="align-items:stretch">

                        <!-- LEFT -->
                        <div class="col-gap">

                            <!-- Description -->
                            <div class="card" style="background:#fff;height:100%">
                                <div class="card-head">
                                    <div class="card-head-title">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                            <line x1="16" y1="13" x2="8" y2="13"/>
                                            <line x1="16" y1="17" x2="8" y2="17"/>
                                        </svg>
                                        Description
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="description-text" t-esc="ticket.description">

                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- RIGHT Sidebar -->
                        <div class="col-gap">

                            <!-- Ticket Details -->
                            <div class="card" style="animation-delay:.08s;">
                                <div class="card-head">
                                    <div class="card-head-title">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <line x1="12" y1="8" x2="12" y2="12"/>
                                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                                        </svg>
                                        Ticket Details
                                    </div>
                                </div>
                                <div class="card-body"
                                     style="padding-top:var(--space-1);padding-bottom:var(--space-1);">
                                    <div class="meta-list">

                                        <div class="meta-row">
                                            <div class="meta-label">ID</div>
                                            <div class="meta-val id-val">
                                                #
                                                <t t-esc="ticket.ticket_ref"></t>
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Status</div>
                                            <div class="meta-val">
                                                <div class="status"
                                                     t-attf-class="status
                                             {{ 'status-new' if ticket.stage_id.name == 'New' else '' }}
                                             {{ 'status-progress' if ticket.stage_id.name == 'In Progress' else '' }}
                                             {{ 'status-solved' if ticket.stage_id.name == 'Solved' else '' }}
                                             {{ 'status-cancelled' if ticket.stage_id.name == 'Cancelled' else '' }}"
                                                     t-esc="ticket.stage_id.name">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Priority</div>
                                            <div class="meta-val">
                                                <!-- Ticket Priority Here-->
                                                <t t-if="ticket.priority == '1'">
                                                    <span class="badge badge-normal">
                                                        <span class="badge-dot"></span>Normal Priority
                                                    </span>
                                                </t>
                                                <t t-elif="ticket.priority == '2'">
                                                    <span class="badge badge-high">
                                                        <span class="badge-dot"></span>High Priority
                                                    </span>
                                                </t>
                                                <t t-elif="ticket.priority == '3'">
                                                    <span class="badge badge-urgent">
                                                        <span class="badge-dot"></span>Urgent Priority
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge badge-low">
                                                        <span class="badge-dot"></span>Low Priority
                                                    </span>
                                                </t>
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Project</div>
                                            <div class="meta-val" style="font-size:var(--fs-xs);"
                                                 t-esc="ticket.project_id.name">Nutrition Depot BD
                                            </div>
                                        </div>


                                        <div class="meta-row">
                                            <div class="meta-label">Assignee</div>
                                            <div class="meta-val">
                                                <div class="person-chip d-flex gap-1 flex-wrap">
                                                    <t t-foreach="ticket.employee_ids" t-as="employee">
                                                        <span class="person-name" t-esc="employee.name"/>,
                                                    </t>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Assigned By</div>
                                            <div class="meta-val">
                                                <div class="person-chip">
                                                    <span class="person-name" t-esc="ticket.user_id.name"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Created</div>
                                            <div class="person-name" t-esc="ticket.assign_date">
                                            </div>
                                        </div>

                                        <div class="meta-row">
                                            <div class="meta-label">Deadline</div>
                                            <div class="meta-val">
                                                <span class="deadline-chip">
                                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2.2">
                                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                                    </svg>
                                                    <t t-esc="ticket.deadline"></t>
                                                </span>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <!-- Update Status -->
                            <div class="card" style="animation-delay:.12s;">
                                <div class="card-head">
                                    <div class="card-head-title">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <polyline points="23 4 23 10 17 10"/>
                                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                                        </svg>
                                        Update Status
                                    </div>
                                </div>
                                <div class="card-body">
                                    <form action="/helpdesks/update_stage" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="ticket_id" t-att-value="ticket.id"/>

                                        <select class="filter-select" name="stage_id" onchange="this.form.submit()"
                                                style="width:100%;max-width:100%">
                                            <t t-foreach="(ticket.team_id.stage_ids or stages)" t-as="stage">
                                                <option t-att-value="stage.id"
                                                        t-att-selected="'selected' if ticket.stage_id.id == stage.id else None"
                                                        t-esc="stage.name"/>
                                            </t>
                                        </select>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>